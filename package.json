{
  "name": "playnow",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.1",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:web:stage7": "node scripts/stage7-web-smoke.mjs",
    "test:web:stage8": "node scripts/stage7-web-smoke.mjs .tools/stage8-web --history",
    "test:web:stage9": "node scripts/stage7-web-smoke.mjs .tools/stage9-export --stability",
    "test:web:stage10": "node scripts/stage7-web-smoke.mjs .tools/stage10-export --refusals",
    "test:web:stage11": "node scripts/stage7-web-smoke.mjs .tools/stage11-export --installed",
    "test:web:stage12": "node scripts/stage12-sync-smoke.mjs .tools/stage12-export",
    "test:sync-api": "node scripts/test-picker-sync-api.mjs",
    "check:mobile-config": "node scripts/check-mobile-config.mjs",
    "export:acceptance": "expo export --platform all --output-dir .tools/stage9-export",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci",
    "test:coverage": "jest --coverage",
    "test:functions": "deno test supabase/functions/"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.tools/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/functions/",
      "/\\.tools/"
    ],
    "roots": [
      "<rootDir>/tests/unit"
    ],
    "testMatch": [
      "**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "collectCoverageFrom": [
      "src/features/*/services/**/*.ts",
      "src/features/*/utils/**/*.ts",
      "src/features/auth/hooks/useAuth.ts",
      "src/shared/{config,services,utils}/**/*.ts",
      "!src/**/default*.ts",
      "!src/shared/services/supabase.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "private": true
}
