{
  "expo": {
    "name": "Quaeso",
    "slug": "playnow",
    "scheme": "playnow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/quaeso-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0C1513",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/quaeso-icon.png",
          "backgroundColor": "#0C1513",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jkwef.playnow",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["steam"]
      }
    },
    "android": {
      "package": "com.jkwef.playnow",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EDF7F1",
        "foregroundImage": "./assets/brand/quaeso-icon.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/quaeso-icon.png"
    },
    "extra": {
      "supabaseUrl": "https://ywlbltxdagjlhevftkst.supabase.co",
      "supabaseAnonKey": "sb_publishable_3oYcm8c7zkYW39YrREjPYQ_ci_sdPY0",
      "privacyPolicyUrl": "https://github.com/JKwef/playnow/blob/main/docs/PRIVACY.md"
    }
  }
}
