# Скопируйте в .env и заполните. Файл .env не коммитится.
#
# Клиентские переменные НЕОБЯЗАТЕЛЬНЫ: значения по умолчанию уже лежат в app.json → extra.
# Задайте их, только если нужно подключить приложение к другому проекту Supabase.
# anon key Supabase публичный по своей природе: доступ к данным режет RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Серверные секреты. В приложение НЕ попадают (см. app.config.ts).
# Их нужно положить в секреты Supabase Edge Functions:
#   npx supabase secrets set STEAM_API_KEY=... RAWG_API_KEY=...
STEAM_API_KEY=your_steam_api_key
RAWG_API_KEY=your_rawg_api_key
