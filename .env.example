# Скопируйте в .env и заполните. Файл .env не коммитится.
#
# Клиентские переменные (попадают в бандл приложения через expo-constants).
# anon key Supabase публичный по своей природе: доступ к данным режет RLS.
SUPABASE_URL=https://supabase.com/dashboard/project/ywlbltxdagjlhevftkst/settings/api-keys
SUPABASE_ANON_KEY=sb_publishable_3oYcm8c7zkYW39YrREjPYQ_ci_sdPY0

# Серверные секреты. В приложение НЕ попадают (см. app.config.ts).
# Их нужно положить в секреты Supabase Edge Functions:
#   npx supabase secrets set STEAM_API_KEY=... RAWG_API_KEY=...
STEAM_API_KEY=your_steam_api_key
RAWG_API_KEY=your_rawg_api_key
